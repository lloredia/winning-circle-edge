# ============================================================
# WINNING CIRCLE × UNDERDOG EDGE™ — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# The Odds API (free tier)
# Get yours at: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key

# Anthropic Claude API
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Sports to track (comma-separated Odds API sport keys)
SPORTS=basketball_nba,basketball_ncaab,soccer_epl

# Timezone for scheduler
TZ=America/Chicago

# Cron schedule (10 AM CT daily)
CRON_SCHEDULE=0 10 * * *

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Dashboard URL (for Telegram link)
DASHBOARD_URL=https://your-dashboard-url.trycloudflare.com

# Optional: API key (when set, require X-API-Key header on /api/*)
# API_KEY=your_secret_key

# Optional: Discord webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# Optional: Notion integration
# NOTION_API_KEY=your_notion_key
# NOTION_DATABASE_ID=your_db_id
