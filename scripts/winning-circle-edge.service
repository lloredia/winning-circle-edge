[Unit]
Description=Winning Circle × UNDERDOG EDGE™ Stack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/path/to/winning-circle-edge
ExecStart=/usr/bin/docker compose up -d
# On Raspberry Pi, use: docker compose -f docker-compose.yml -f docker-compose.raspberrypi.yml up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
